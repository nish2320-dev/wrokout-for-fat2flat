{
  "expo": {
    "name": "Fat2Flat Fitness",
    "slug": "fat2flat-fitness",
    "owner": "nish2320",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fat2flat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fat2flat.fitness",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.fat2flat.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_NUTRITION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fat2Flat Fitness uses the camera to scan barcodes on food packaging and, if you choose, to take progress photos. Photos stay on your iPhone unless you share them with your coach.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fat2Flat Fitness lets you choose progress photos from your library. They stay on your iPhone unless you choose to share them with your coach.",
          "cameraPermission": "Fat2Flat Fitness uses the camera to scan barcodes on food packaging and, if you choose, to take progress photos. Photos stay on your iPhone unless you share them with your coach.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Fat2Flat Fitness reads your steps, active calories, workouts, weight, body fat, sleep and resting heart rate to show your activity, keep your weigh-ins up to date and, if you choose, share your progress with your coach.",
          "NSHealthUpdateUsageDescription": "Fat2Flat Fitness saves the workouts and meals you log to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9a17935b-6905-44f9-9925-65581025dcdf"
      },
      "supabaseUrl": "https://iycgmlwiglrvlyetkwzi.supabase.co",
      "supabaseKey": "sb_publishable_YA2VUAbkR1j9SIYpCwfQ2g_umicJo2B"
    }
  }
}
