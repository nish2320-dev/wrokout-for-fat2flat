{
  "expo": {
    "name": "Fat2Flat Fitness",
    "slug": "fat2flat-fitness",
    "owner": "nish2320",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fat2flat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fat2flat.fitness",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fat2flat.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fat2Flat Fitness uses the camera to scan barcodes on food packaging and, if you choose, to take progress photos. Photos stay on your iPhone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fat2Flat Fitness lets you choose progress photos from your library. They stay on your iPhone and are never uploaded.",
          "cameraPermission": "Fat2Flat Fitness uses the camera to scan barcodes on food packaging and, if you choose, to take progress photos. Photos stay on your iPhone.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9a17935b-6905-44f9-9925-65581025dcdf"
      }
    }
  }
}
